rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function isValidScoreEntry(data) {
      return data.keys().hasAll(['alias', 'score', 'wave', 'createdAt'])
        && data.keys().hasOnly(['alias', 'score', 'wave', 'createdAt'])
        && data.alias is string
        && data.alias.size() >= 3
        && data.alias.size() <= 5
        && data.alias.matches('^[A-Z0-9_\\-]+$')
        && data.score is int
        && data.score >= 0
        && data.score <= 10000000
        && data.wave is int
        && data.wave >= 1
        && data.wave <= 999
        && data.createdAt is timestamp
        && data.createdAt == request.time;
    }

    match /scores/{scoreId} {
      allow get: if isValidId(scoreId);
      allow list: if request.query.limit != null && request.query.limit <= 10;
      allow create: if isValidId(scoreId) && isValidScoreEntry(incoming());
      allow update, delete: if false;
    }
  }
}
